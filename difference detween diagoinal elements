#include <stdio.h>
#include <math.h>
#include <stdlib.h>
int main()
{
   int n,s=0,b=0;
   scanf("%d",&n);
   int a[n][n];
   for(int i=0;i<n;i++){
       for(int j=0;j<n;j++){
           scanf("%d",&a[i][j]);
       }
   }
   for(int i=0;i<n;i++){
       s+=a[i][i];
       b+=a[i][n-i-1];
   }
   printf("%d ",abs(s-b));

    return 0;
}
